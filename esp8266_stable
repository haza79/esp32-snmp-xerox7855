// ============================================================
//  Preferences shim for ESP8266 (EEPROM-backed, 96-byte slots)
// ============================================================
class Preferences {
public:
  bool begin(const char*, bool = false) { EEPROM.begin(2048); return true; }
  void end() { EEPROM.commit(); }

  String getString(const char* key, const String& def = "") {
    int addr = findKey(key);
    if (addr < 0) return def;
    int len = EEPROM.read(addr);
    if (len <= 0 || len > 90) return def;
    String s;
    for (int i = 0; i < len; i++) s += (char)EEPROM.read(addr + 1 + i);
    return s;
  }
  void putString(const char* key, const String& value) { writeEntry(key, value); }

  bool getBool(const char* key, bool def = false) {
    String v = getString(key, def ? "1" : "0");
    return v == "1";
  }
  void putBool(const char* key, bool value) { putString(key, value ? "1" : "0"); }
  void remove(const char* key) { writeEntry(key, ""); }

private:
  static const int SLOT_SIZE  = 96;
  static const int SLOT_COUNT = 16;
  static const int SLOT_BASE  = 0;

  int slotAddr(int i) { return SLOT_BASE + i * SLOT_SIZE; }

  int findKey(const char* key) {
    for (int i = 0; i < SLOT_COUNT; i++) {
      int a = slotAddr(i);
      int klen = EEPROM.read(a);
      if (klen <= 0 || klen > 15) continue;
      String k;
      for (int j = 0; j < klen; j++) k += (char)EEPROM.read(a + 1 + j);
      if (k == key) return a + 1 + klen;
    }
    return -1;
  }

  int findFreeSlot() {
    for (int i = 0; i < SLOT_COUNT; i++) {
      int a = slotAddr(i);
      int klen = EEPROM.read(a);
      if (klen == 0 || klen > 15) return a;
    }
    return -1;
  }

  void writeEntry(const char* key, const String& value) {
    int klen = strlen(key);
    if (klen > 15) return;
    int vlen = value.length();
    if (vlen > SLOT_SIZE - 2 - klen) vlen = SLOT_SIZE - 2 - klen;

    int slotBase = -1;
    for (int i = 0; i < SLOT_COUNT; i++) {
      int a = slotAddr(i);
      int kl = EEPROM.read(a);
      if (kl == klen) {
        bool match = true;
        for (int j = 0; j < klen; j++)
          if ((char)EEPROM.read(a + 1 + j) != key[j]) { match = false; break; }
        if (match) { slotBase = a; break; }
      }
    }
    if (slotBase < 0) slotBase = findFreeSlot();
    if (slotBase < 0) return;

    EEPROM.write(slotBase, (uint8_t)klen);
    for (int j = 0; j < klen; j++) EEPROM.write(slotBase + 1 + j, key[j]);
    EEPROM.write(slotBase + 1 + klen, (uint8_t)vlen);
    for (int j = 0; j < vlen; j++)
      EEPROM.write(slotBase + 2 + klen + j, value[j]);
  }
};

