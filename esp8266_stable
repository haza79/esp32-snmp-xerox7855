}

// ============================================================
//  SNMP
// ============================================================
void setupSNMP() {
  snmp.setUDP(&udp);
  snmp.begin();
  IPAddress printerIP;
  printerIP.fromString(config.printerIP);
  for (int i = 0; i < OID_COUNT; i++) {
    if (oidList[i].isString)
      callbacks[i] = snmp.addStringHandler(printerIP, oidList[i].oid,
                                           (char**)&oidList[i].valuePtr);
    else
      callbacks[i] = snmp.addIntegerHandler(printerIP, oidList[i].oid,
                                            (int*)oidList[i].valuePtr);
  }
}

void runSNMP() {
  if (WiFi.status() != WL_CONNECTED) return;
  IPAddress printerIP;
  printerIP.fromString(config.printerIP);

  Serial.println("\n📡 SNMP main query…");
  SNMPGet request("public", 1);
  for (int i = 0; i < OID_COUNT; i++) request.addOIDPointer(callbacks[i]);
  request.setUDP(&udp);
  request.setRequestID(random(1000, 9999));
  request.sendTo(printerIP);

  if (waitForSNMPResponse(5000)) Serial.println("✅ SNMP OK");
  else                            Serial.println("⚠️ SNMP timeout");

  printResults();
  runVersionQuery();       // separate — sysDescr.0
  runPrinterIPQuery();     // separate — printer IP OID
}

void runVersionQuery() {
  IPAddress printerIP;
  printerIP.fromString(config.printerIP);
  sysDescr[0] = 0;
  char* p = sysDescr;

  SNMPGet vReq("public", 1);
  ValueCallback* cb = snmp.addStringHandler(printerIP, ".1.3.6.1.2.1.1.1.0", &p);
  vReq.addOIDPointer(cb);
  vReq.setUDP(&udp);
  vReq.setRequestID(random(1000, 9999));
  vReq.sendTo(printerIP);

  unsigned long start = millis();
  while (millis() - start < 3000) { snmp.loop(); delay(20); }
  extractVersionRaw();
  printVersion();
}

// Query the printer's self-reported IP from the Xerox OID
void runPrinterIPQuery() {
  IPAddress printerIP;
  printerIP.fromString(config.printerIP);

  printerIPSensed[0] = 0;
  char* p = printerIPSensed;

  SNMPGet ipReq("public", 1);
  ValueCallback* cb = snmp.addStringHandler(printerIP, PRINTER_IP_OID, &p);
  ipReq.addOIDPointer(cb);
  ipReq.setUDP(&udp);
  ipReq.setRequestID(random(1000, 9999));
  ipReq.sendTo(printerIP);

  unsigned long start = millis();
  while (millis() - start < 3000) { snmp.loop(); delay(20); }

  if (strlen(printerIPSensed) == 0) {
    // fall back to configured IP if OID didn't answer
    strncpy(printerIPSensed, config.printerIP, sizeof(printerIPSensed) - 1);
    printerIPSensed[sizeof(printerIPSensed) - 1] = 0;
    Serial.println("(printer IP OID empty, using configured IP)");
  }
  Serial.printf("Printer IP (from OID): %s\n", printerIPSensed);
}

void extractVersionRaw() {
  softwareVersion[0] = 0;
  String d = String(sysDescr);
  int k = d.indexOf("SS ");
  if (k < 0) { d.toCharArray(softwareVersion, sizeof(softwareVersion)); return; }
  String v = d.substring(k); v.trim();
  v.toCharArray(softwareVersion, sizeof(softwareVersion));
}

bool waitForSNMPResponse(unsigned long timeoutMs) {
  unsigned long start = millis();
  while (millis() - start < timeoutMs) {
    snmp.loop(); delay(50);
    if (isSNMPDataValid()) return true;
  }
  return false;
}

bool isSNMPDataValid() {
  if (strlen(deviceDescr) == 0) return false;
  if (strlen(systemName)  == 0) return false;
  if (strlen(serialNum)   == 0) return false;
  if (blackTotal == 0 && colorTotal == 0 && totalAll == 0) return false;
  return true;
}

