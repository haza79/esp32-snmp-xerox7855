// ============================================================
//  SETUP
// ============================================================
void setup() {
  Serial.begin(9600);
  delay(200);
  pinMode(CONFIG_BUTTON, INPUT_PULLUP);
  pinMode(LED, OUTPUT);
  digitalWrite(LED, LED_OFF);

  Serial.println("\n\n=== ESP8266 Xerox AltaLink C8055 Bridge ===");
  Serial.printf("Chip ID: %s\n", getChipID().c_str());

  loadConfig();
  Serial.printf("Stored hostname: [%s]\n", config.hostname);
  Serial.printf("Stored printer : [%s]\n", config.printerIP);

  if (strlen(config.ssid) == 0) { startConfigMode(); return; }

  setupWiFiNormal();
  setupSNMP();
  configTime(7 * 3600, 0, "pool.ntp.org", "time.nist.gov");
  Serial.println("System ready — waiting for schedule...");
}

// ============================================================
//  LOOP
// ============================================================
void loop() {
  server.handleClient();
  snmp.loop();

  if (digitalRead(CONFIG_BUTTON) == LOW) {
    if (!buttonHeld) { buttonHeld = true; buttonPressStart = millis(); }
    if (millis() - buttonPressStart >= 2000) {
      buttonHeld = false;
      startConfigMode();
      return;
    }
  } else {
    buttonHeld = false;
  }

  checkWiFiReconnect();
  if (configMode) return;

  unsigned long now = millis();
  if (now - lastScheduleCheck >= 60000) {
    lastScheduleCheck = now;
    if (isScheduleTime()) { runSNMP(); saveMeter(); }
  }
  if (now - lastCommandCheck >= 60000) { lastCommandCheck = now; checkCloudCommand(); }
  if (now - lastPingCheck    >= 60000) { lastPingCheck    = now; pingServer(); }
  retryPendingCommand();
}

// ============================================================
//  HTTP helpers
// ============================================================
String getWithRetry(String url, int maxRetries, int timeoutMs) {
  for (int a = 0; a < maxRetries; a++) {
    int code = -1;
    String r;

    if (url.startsWith("https://")) {
      WiFiClientSecure client;
      client.setInsecure();
      HTTPClient http;
      http.begin(client, url);
      http.setTimeout(timeoutMs);
      http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
      code = http.GET();
      if (code > 0) r = http.getString();
      http.end();
    } else {
      WiFiClient client;
      HTTPClient http;
      http.begin(client, url);
      http.setTimeout(timeoutMs);
      http.setFollowRedirects(HTTPC_STRICT_FOLLOW_REDIRECTS);
      code = http.GET();
      if (code > 0) r = http.getString();
      http.end();
    }

    if (code > 0) {
      Serial.printf("📡 GET %d: %s\n", code, r.c_str());
      return r;
    }
    Serial.printf("⚠️ GET fail %d/%d code %d url=%s\n",
                  a + 1, maxRetries, code, url.c_str());
    delay(5000);
  }
  Serial.printf("❌ GET failed: %s\n", url.c_str());
  return "";
}

String postWithRetry(String url, String payload, int maxRetries, int timeoutMs) {
  for (int a = 0; a < maxRetries; a++) {
    int code = -1;
    String r;

    if (url.startsWith("https://")) {
      WiFiClientSecure client;
      client.setInsecure();
      HTTPClient http;
      http.begin(client, url);
      http.setTimeout(timeoutMs);
      http.addHeader("Content-Type", "application/x-www-form-urlencoded");
      code = http.POST(payload);
      if (code > 0) r = http.getString();
      http.end();
    } else {
      WiFiClient client;
      HTTPClient http;
      http.begin(client, url);
      http.setTimeout(timeoutMs);
      http.addHeader("Content-Type", "application/x-www-form-urlencoded");
      code = http.POST(payload);
      if (code > 0) r = http.getString();
      http.end();
    }

    if (code > 0) {
      Serial.printf("📤 POST %d: %s\n", code, r.c_str());
      return r;
    }
    Serial.printf("⚠️ POST fail %d/%d code %d url=%s\n",
                  a + 1, maxRetries, code, url.c_str());
    delay(5000);
  }
  Serial.printf("❌ POST failed: %s\n", url.c_str());
  return "";
}

String urlEncode(const String& s) {
  String out; char buf[5];
  for (size_t i = 0; i < s.length(); i++) {
    char c = s[i];
    if (isalnum((unsigned char)c) || c=='-' || c=='_' || c=='.' || c=='~') out += c;
    else if (c == ' ') out += '+';
    else { sprintf(buf, "%%%02X", (uint8_t)c); out += buf; }
  }
  return out;
}

// ============================================================
//  CONFIG MODE
// ============================================================
void startConfigMode() {
  configMode = true;
  digitalWrite(LED, LED_ON);

  WiFi.disconnect(true);
  delay(300);
  WiFi.mode(WIFI_AP);
  WiFi.softAP("ESP32_Config", "12345678");
  Serial.printf("📶 AP 'ESP32_Config' → http://%s\n",
                WiFi.softAPIP().toString().c_str());

  server.on("/", []() {
    int n = WiFi.scanNetworks();
    String page = "<html><head><meta name='viewport' content='width=device-width,initial-scale=1'></head><body>";
    page += "<h2>ESP Serial: " + getChipID() + "</h2>";
    page += "<h2>Current SSID: " + String(config.ssid) + "</h2>";
    page += "<h2>Current Host: " + String(config.hostname) + "</h2>";
    page += "<h3>Select WiFi Network</h3><ul>";
    for (int i = 0; i < n; i++)
      page += "<li><a href='/select?ssid=" + WiFi.SSID(i) + "'>" + WiFi.SSID(i) +
              " (" + String(WiFi.RSSI(i)) + " dBm)</a></li>";
    page += "</ul></body></html>";
    server.send(200, "text/html", page);
  });

  server.on("/select", []() {
    String ssid = server.arg("ssid");
    String page = "<html><head><meta name='viewport' content='width=device-width,initial-scale=1'></head><body>";
    page += "<h2>Connect to: " + ssid + "</h2>";
    page += "<form action='/test' method='POST'>";
    page += "<input type='hidden' name='ssid' value='" + ssid + "'>";
    page += "Host name (full URL): <input name='hostname' size='60' value='" +
            String(config.hostname) + "'><br>";
    page += "ESP Board name: <input name='esp32Name' value='" +
            String(config.esp32Name) + "'><br>";
    page += "WiFi password: <input name='password' type='password'><br><br>";
    page += "Printer IP: <input name='printer' value='" +
            String(config.printerIP) + "'><br><br>";
    page += "<input type='submit' value='Test Connection'>";
    page += "</form></body></html>";
    server.send(200, "text/html", page);
  });

  server.on("/test", []() {
    String ssid      = server.arg("ssid");
    String hostname  = server.arg("hostname");
    String esp32name = server.arg("esp32Name");
    String password  = server.arg("password");
    String printer   = server.arg("printer");
    hostname.trim();

    WiFi.mode(WIFI_STA);
    WiFi.begin(ssid.c_str(), password.c_str());
    int t = 0;
    while (WiFi.status() != WL_CONNECTED && t++ < 20) delay(500);

    if (WiFi.status() == WL_CONNECTED) {
      prefs.begin("esp32cfg", false);
      prefs.putString("hostname",   hostname);
      prefs.putString("esp32Name",  esp32name);
      prefs.putString("ssid",       ssid);
      prefs.putString("pass",       password);
      prefs.putString("printer",    printer);
      prefs.putBool  ("firstSetup", true);
      prefs.end();

      Serial.printf("💾 Saved hostname: [%s]\n", hostname.c_str());

      server.send(200, "text/html",
        "<html><body><h2>Connected Successfully!</h2>"
        "<p>Saved: " + hostname + "</p><p>Rebooting...</p></body></html>");
      delay(2000);
      digitalWrite(LED, LED_OFF);
      ESP.restart();
    } else {
      server.send(200, "text/html",
        "<html><body><h2>❌ Failed to connect to WiFi</h2>"
        "<a href='/'>Back</a></body></html>");
      digitalWrite(LED, LED_OFF);
      ESP.restart();
    }
  });

  server.begin();
  Serial.println("🌐 Config web active.");
}

// ============================================================
//  NORMAL WIFI
// ============================================================
void setupWiFiNormal() {
  WiFi.mode(WIFI_STA);
  WiFi.hostname("ESP8266_Printer");
  WiFi.begin(config.ssid, config.password);
  Serial.printf("Connecting to %s", config.ssid);

  int retry = 0;
  while (WiFi.status() != WL_CONNECTED && retry++ < 40) {
    delay(500); Serial.print(".");
  }

  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("\n⚠️ WiFi failed — will retry in loop");
    return;
  }
  Serial.printf("\n✅ Connected, IP: %s\n", WiFi.localIP().toString().c_str());

  if (config.firstSetup) {
    String postData = "espSerial=" + getChipID() + "&espName=" + urlEncode(String(config.esp32Name));
    Serial.printf("📤 Registering with %s\n", addEspUrl.c_str());
    postWithRetry(addEspUrl, postData);
    prefs.begin("esp32cfg", false);
    prefs.putBool("firstSetup", false);
    prefs.end();
  }

  server.on("/config", []() {
    server.send(200, "text/html",
      "<h3>Entering Config Mode...</h3>"
      "<p>Reconnect to <b>ESP32_Config</b> WiFi.</p>");
    delay(500);
    startConfigMode();
  });
  server.begin();
}

void checkWiFiReconnect() {
  if (configMode) return;
  if (WiFi.status() != WL_CONNECTED && millis() - lastWiFiCheck > 5000) {
    lastWiFiCheck = millis();
    Serial.println("🔄 WiFi lost — retrying...");
    WiFi.reconnect();
  }
}

