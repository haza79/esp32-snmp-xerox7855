}

// ============================================================
//  SAVE METER
// ============================================================
void saveMeter() {
  String printerId = getWithRetry(getEspIdUrl + "?serial=" + getChipID());
  if (printerId.length() == 0) {
    Serial.println("❌ printerId fetch failed — queuing");
    prefs.begin("esp32cfg", false);
    prefs.putString("pendingCommand", "run");
    prefs.end();
    return;
  }
  printerId.trim();

  // Use the sensed IP if available, else fall back to configured one
  String printerIPUsed = strlen(printerIPSensed) > 0
                       ? String(printerIPSensed)
                       : String(config.printerIP);

  String postData =
      "printerId="            + printerId +
      "&printerModel="        + urlEncode(String(deviceDescr)) +
      "&printerSystemName="   + urlEncode(String(systemName)) +
      "&printerSerialNumber=" + urlEncode(String(serialNum)) +
      "&printerIP="           + urlEncode(printerIPUsed) +
      "&softwareVersion="     + urlEncode(String(softwareVersion)) +
      "&powerOnImpr="         + String(powerOnImpr) +
      "&blackCopy="           + String(blackCopy) +
      "&colorCopy="           + String(colorCopy) +
      "&blackPrint="          + String(blackPrint) +
      "&colorPrint="          + String(colorPrint) +
      "&networkScan="         + String(networkScan) +
      "&emailScan="           + String(emailScan) +
      "&totalBlack="          + String(blackTotal) +
      "&totalColor="          + String(colorTotal) +
      "&totalBlackLarge="     + String(blackLargeTotal) +
      "&totalColorLarge="     + String(colorLargeTotal) +
      "&total="               + String(totalAll);

  if (postWithRetry(addMeterUrl, postData).length() == 0) {
    Serial.println("❌ POST failed — queuing");
    prefs.begin("esp32cfg", false);
    prefs.putString("pendingCommand", "run");
    prefs.end();
  }
}

void retryPendingCommand() {
  prefs.begin("esp32cfg", true);
  String cmd = prefs.getString("pendingCommand", "");
  prefs.end();
  if (cmd == "run") {
    Serial.println("🔄 Retrying pending run…");
    saveMeter();
    prefs.begin("esp32cfg", false);
    prefs.remove("pendingCommand");
    prefs.end();
  }
}

// ============================================================
//  CLOUD COMMAND
// ============================================================
void checkCloudCommand() {
  if (WiFi.status() != WL_CONNECTED) return;
  String cmd = getWithRetry(getCommandUrl + "?serial=" + getChipID());
  if (cmd != "" && cmd.indexOf("run") >= 0) {
    Serial.println("🚀 Cloud RUN");
    runSNMP(); saveMeter(); clearCloudCommand();
  }
}

void clearCloudCommand() {
  getWithRetry(setCommandUrl + "?serial=" + getChipID() + "&cmd=none");
}

String pingServer() {
  String response = getWithRetry(pingUrl + "?serial=" + getChipID());
  if (response.length() == 0) return "";
  Serial.print("📡 Ping: "); Serial.println(response);
  if (response.indexOf("\"command\":\"run\"") > 0) {
    Serial.println("🚀 RUN from heartbeat");
    runSNMP(); saveMeter(); clearCloudCommand();
  }
  return response;
}

// ============================================================
//  SCHEDULE
// ============================================================
bool isScheduleTime() {
  time_t now = time(nullptr);
  struct tm* t = localtime(&now);
  for (int i = 0; i < (int)(sizeof(scheduleHours) / sizeof(int)); i++) {
    if (t->tm_hour == scheduleHours[i] && t->tm_min == scheduleMinutes[i]) {
      Serial.printf("⏰ Scheduled %02d:%02d\n", t->tm_hour, t->tm_min);
      for (int k = 0; k < 60; k++) { yield(); delay(1000); }
      return true;
    }
  }
  return false;
}

// ============================================================
//  CHIP ID
// ============================================================
String getChipID() {
  uint8_t mac[6];
  WiFi.macAddress(mac);
  char buf[13];
  sprintf(buf, "%02X%02X%02X%02X%02X%02X",
          mac[0], mac[1], mac[2], mac[3], mac[4], mac[5]);
  return String(buf);
}
